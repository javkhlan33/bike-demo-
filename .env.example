# App
# On Vercel, set NEXT_PUBLIC_APP_URL to your production URL (e.g. https://your-app.vercel.app).
# If unset, QR links fall back to https://$VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — https://dashboard.clerk.com
# REQUIRED on Vercel (Production + Preview): same names as below.
# Missing these causes Internal Server Error on every page (clerkMiddleware + ClerkProvider).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# MongoDB — Atlas connection string recommended for production
# REQUIRED on Vercel for dashboard / register / search / verify.
# Must include database name (e.g. /bike_mn). If dashboard fails with
# "SCRAM failure: bad auth", the Atlas username/password in this URL is wrong —
# reset the DB user password in Atlas and update this value. Do not force-reset data.
# Atlas Network Access must allow Vercel (commonly 0.0.0.0/0 for serverless).
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER/bike_mn?retryWrites=true&w=majority

# Cloudinary — bicycle side (public) + serial (private authenticated) photos
# Optional until photo upload is used in production. Never put CLOUDINARY_API_SECRET in client code.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
